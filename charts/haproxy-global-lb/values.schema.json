{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["clusterId", "clusterDomain", "replicaCount", "image", "haproxy", "globalLb", "stateStore", "service", "backends"],
  "properties": {
    "fullnameOverride": {"type": "string", "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", "maxLength": 63},
    "clusterId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "clusterDomain": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253},
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {"$ref": "#/definitions/image"},
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
    "haproxy": {
      "type": "object",
      "properties": {
        "threads": {"type": "integer", "minimum": 1, "maximum": 256},
        "updateStrategy": {"enum": ["OnDelete", "RollingUpdate"]},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "timeout": {"type": "object", "properties": {
          "connect": {"$ref": "#/definitions/duration"}, "client": {"$ref": "#/definitions/duration"},
          "server": {"$ref": "#/definitions/duration"}, "queue": {"$ref": "#/definitions/duration"},
          "check": {"$ref": "#/definitions/duration"}
        }, "additionalProperties": false}
      }, "additionalProperties": false
    },
    "globalLb": {
      "type": "object",
      "properties": {
        "keyPrefix": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,127}$"},
        "reserveTimeout": {"$ref": "#/definitions/duration"},
        "heartbeatInterval": {"$ref": "#/definitions/duration"},
        "instanceTimeout": {"$ref": "#/definitions/duration"},
        "connectTimeout": {"$ref": "#/definitions/duration"},
        "commandTimeout": {"$ref": "#/definitions/duration"},
        "reconnectInitial": {"$ref": "#/definitions/duration"},
        "reconnectMaximum": {"$ref": "#/definitions/duration"},
        "maxInstances": {"type": "integer", "minimum": 1, "maximum": 524287},
        "maxRequests": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }, "additionalProperties": false
    },
    "stateStore": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"enum": ["valkey", "redis"]},
        "externalAddress": {"type": "string", "pattern": "^$|^([A-Za-z0-9][A-Za-z0-9.-]*|\\[[A-Fa-f0-9:]+\\]):[0-9]{1,5}$"},
        "images": {"type": "object", "properties": {"redis": {"$ref": "#/definitions/image"}, "valkey": {"$ref": "#/definitions/image"}}, "additionalProperties": false},
        "pullPolicy": {"$ref": "#/definitions/pullPolicy"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "networkPolicy": {"type": "object", "properties": {"enabled": {"type": "boolean"}}, "additionalProperties": false}
      }, "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {"enum": ["LoadBalancer", "NodePort", "ClusterIP"]},
        "externalTrafficPolicy": {"enum": ["Local", "Cluster"]},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "loadBalancerIP": {"type": "string"}
      }, "additionalProperties": false
    },
    "backends": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["name", "portName", "port", "srv", "slots", "serverPort", "proxyProtocolV2", "healthCheck"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,62}$"},
          "portName": {"type": "string", "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$", "maxLength": 15},
          "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
          "srv": {"type": "string", "pattern": "^_[A-Za-z0-9-]+\\._tcp\\.[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$", "maxLength": 253},
          "slots": {"type": "integer", "minimum": 1, "maximum": 4096},
          "serverPort": {"type": "integer", "minimum": 1, "maximum": 65535},
          "proxyProtocolV2": {"type": "boolean"},
          "healthCheck": {"type": "object", "required": ["interval", "fastInterval", "downInterval", "rise", "fall"], "properties": {
            "interval": {"$ref": "#/definitions/duration"}, "fastInterval": {"$ref": "#/definitions/duration"},
            "downInterval": {"$ref": "#/definitions/duration"}, "rise": {"type": "integer", "minimum": 1}, "fall": {"type": "integer", "minimum": 1}
          }, "additionalProperties": false}
        }, "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "duration": {"type": "string", "pattern": "^[1-9][0-9]*(us|ms|s|m|h|d)$"},
    "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
    "image": {"type": "object", "required": ["repository", "tag"], "properties": {
      "repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1},
      "pullPolicy": {"$ref": "#/definitions/pullPolicy"}
    }, "additionalProperties": false}
  }
}
